# Beacon environment (names only — no secrets)

## App
NODE_ENV=development
APP_NAME=beacon
APP_URL=http://localhost:5173
API_URL=http://localhost:3001
API_PORT=3001
WEB_PORT=5173
LOG_LEVEL=info
SESSION_SECRET=
ANALYTICS_SALT=
CHAIN_ID=114
NETWORK_NAME=coston2

## Flare Coston2

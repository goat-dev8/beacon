{
  "_comment": "Replace with your ComfyUI Dev-Mode 'Save (API Format)' Flux.2 / SDXL export. Placeholders __PROMPT__ __NEGATIVE__ __SEED__ __WIDTH__ __HEIGHT__ are substituted by Beacon.",
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "__SEED__",
      "steps": 28,
      "cfg": 7,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1,
      "model": ["4", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["5", 0]
    }
  },
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "v1-5-pruned-emaonly.safetensors" }
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": "__WIDTH__", "height": "__HEIGHT__", "batch_size": 1 }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "__PROMPT__", "clip": ["4", 1] },
    "_meta": { "title": "Positive" }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "__NEGATIVE__", "clip": ["4", 1] },
    "_meta": { "title": "Negative" }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["3", 0], "vae": ["4", 2] }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": { "filename_prefix": "beacon", "images": ["8", 0] }
  }
}
